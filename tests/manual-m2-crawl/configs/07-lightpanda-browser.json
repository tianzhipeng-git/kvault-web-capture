{
  "seedUrls": [
    "http://127.0.0.1:4328/docs"
  ],
  "sitemaps": [],
  "rulesBeforeBaseEq": [
    {
      "name": "scope-site",
      "matchType": "url",
      "listType": "scopelist",
      "ruleType": "prefix",
      "values": [
        "127.0.0.1:4328"
      ]
    }
  ],
  "rulesBeforeStage2Eq": [
    {
      "name": "docs-browser-artifacts",
      "matchType": "url",
      "listType": "whitelist",
      "ruleType": "prefix",
      "values": [
        "127.0.0.1:4328/docs"
      ],
      "artifacts": [
        "markdown",
        "screenshot"
      ]
    }
  ],
  "runOptions": {
    "seedMaxDepth": 0,
    "crawlMaxDepth": 1
  },
  "captureProfiles": {
    "default": {
      "tools": [
        "http-base",
        "lightpanda-markdown",
        "playwright-screenshot"
      ],
      "validation": {
        "markdown": {
          "minLength": 300
        },
        "screenshot": {
          "minBytes": 10000
        }
      }
    }
  },
  "defaultCaptureProfile": "default",
  "browser": {
    "engine": "lightpanda",
    "profileMode": "ephemeral",
    "reuse": "run_browser",
    "contextReuse": "site_run",
    "pageReuse": "none",
    "proxyBinding": "none"
  },
  "proxyPolicy": {
    "mode": "off"
  }
}
