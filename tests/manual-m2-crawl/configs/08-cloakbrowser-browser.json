{
  "seedUrls": [
    "http://127.0.0.1:4328/docs"
  ],
  "sitemaps": [],
  "rulesBeforeBaseEq": [
    {
      "name": "scope-site",
      "matchType": "url",
      "listType": "scopelist",
      "ruleType": "prefix",
      "values": [
        "127.0.0.1:4328"
      ]
    }
  ],
  "rulesBeforeStage2Eq": [
    {
      "name": "docs-cloak-screenshot",
      "matchType": "url",
      "listType": "whitelist",
      "ruleType": "prefix",
      "values": [
        "127.0.0.1:4328/docs"
      ],
      "artifacts": [
        "screenshot"
      ]
    }
  ],
  "runOptions": {
    "seedMaxDepth": 0,
    "crawlMaxDepth": 1
  },
  "browser": {
    "engine": "cloakbrowser",
    "profileMode": "ephemeral",
    "reuse": "run_browser",
    "contextReuse": "site_session_proxy",
    "pageReuse": "none",
    "proxyBinding": "session"
  },
  "captureProfile": {
    "tools": [
      "http-base",
      "playwright-screenshot"
    ]
  },
  "validation": {
    "screenshot": {
      "minBytes": 20000
    }
  }
}
